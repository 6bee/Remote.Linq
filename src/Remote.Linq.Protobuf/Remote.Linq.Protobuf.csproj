<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0;net10.0</TargetFrameworks>
    <PackageTags>remote-linq;protobuf;google-protobuf;proto3;binary;serialization</PackageTags>
    <Description>Provides schema-first Google.Protobuf serialization for Remote.Linq types.</Description>
    <IncludeGlobalAssemblyInfo>false</IncludeGlobalAssemblyInfo>
    <IncludeAquaProtos>true</IncludeAquaProtos>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="aqua-core-protobuf" />
    <PackageReference Include="Grpc.Tools" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Remote.Linq\Remote.Linq.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="Protos\remote.linq.proto" ProtoRoot="Protos" GrpcServices="None" Access="Public" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Google.Protobuf" Global="true" />
    <Using Include="Aqua.Protobuf" Global="true" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Protos\**\*.proto" Pack="true" PackagePath="content/protos/%(RecursiveDir)" />
    <None Include="BuildTransitive\**" Pack="true" PackagePath="buildTransitive/%(RecursiveDir)" />
  </ItemGroup>

</Project>
